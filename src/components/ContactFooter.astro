---
// The contact footer shared by the home page (with headshot + stamps) and the
// inner pages (PageLayout). Everything in it comes from the Contact and Site
// singletons in Sanity.
import Emphasis from './Emphasis.astro';
import { imageUrl } from '../lib/sanity';

interface Props {
  site: any;
  contact: any;
  /** Home page: headshot beside the heading, and id="contact" for the nav anchor. */
  withHeadshot?: boolean;
  isActive?: (href: string) => boolean;
}
const { site, contact, withHeadshot = false, isActive = () => false } = Astro.props;
const headshot = withHeadshot ? imageUrl(contact.headshot, 600) : undefined;
---
<footer id={withHeadshot ? 'contact' : undefined}>
  <slot />
  <div class="wrap">
    {withHeadshot ? (
      <div class="contact-lead">
        {headshot && (
          <figure class="contact-headshot">
            <img src={headshot} alt={site.name} />
          </figure>
        )}
        <div class="contact-intro">
          <h3><Emphasis text={contact.heading} emphasis={contact.emphasis} /></h3>
          <p class="pitch">{contact.pitch}</p>
        </div>
      </div>
    ) : (
      <div>
        <h3><Emphasis text={contact.heading} emphasis={contact.emphasis} /></h3>
        <p class="pitch">{contact.pitch}</p>
      </div>
    )}
    <div>
      <div class="col-label">Email</div>
      <ul><li><a href={`mailto:${contact.email}`}>{contact.email}</a></li></ul>
      <div class="col-label" style="margin-top:24px">Press kit</div>
      <ul><li><a href={contact.pressKit?.url} download>{contact.pressKit?.label}</a></li></ul>
    </div>
    <div>
      <div class="col-label">Elsewhere</div>
      <ul>
        {(contact.elsewhere ?? []).map((l: any) => (
          <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <div class="col-label">On file</div>
      <ul>
        {(contact.onFile ?? []).map((l: any) => (
          <li><a href={l.url} class:list={{ active: isActive(l.url) }}>{l.label}</a></li>
        ))}
      </ul>
    </div>
    <div class="colophon">
      {(site.colophon ?? []).map((line: string) => <span>{line}</span>)}
    </div>
  </div>
</footer>
