---
// Each page loads one stylesheet bundle (styles/bundles/) so the design's layer order holds
import '../styles/bundles/home.css';
import Base from '../layouts/Base.astro';
import AboutSection from '../components/AboutSection.astro';
import { fetchAbout } from '../lib/queries';

const { sections, about } = await fetchAbout();
---
<Base title="About — Amelie Brazelton">
  <main>
    <AboutSection about={about} num={sections.about.num} />
  </main>
</Base>
