---
import Base from '../../layouts/Base.astro';
import Emphasis from '../../components/Emphasis.astro';
import '../../styles/essay.css';
import '../../styles/theme-site.css';
import { imageUrl } from '../../lib/sanity';
import { fetchEssays, fetchSite } from '../../lib/queries';
import { renderBody } from '../../lib/portableText';

export async function getStaticPaths() {
  const essays = await fetchEssays();
  return essays.map((essay: any) => ({ params: { slug: essay.slug }, props: { essay } }));
}

const { essay } = Astro.props;
const site = await fetchSite();
const img = imageUrl(essay.image, 1400);
// Drop cap on the opening letter, as an explicit span (essay.css)
const bodyHtml = renderBody(essay.body).replace(/^<p>([A-Za-zÀ-ÿ])/, '<p><span class="dropcap">$1</span>');
const minutes = essay.words ? Math.max(1, Math.round(essay.words / 230)) : 0;
const firstName = (site.name ?? '').split(' ')[0];
---
<Base title={`${essay.title} — ${site.name}`} description={essay.excerpt} bodyClass="essay" showFooter={false}>
  <article class="essay-wrap">
    <a class="essay-back" href="/creative/">← The notebook</a>

    <header class="essay-head">
      <div class="cat">{essay.category}</div>
      <h1><Emphasis text={essay.title} emphasis={essay.emphasis} /></h1>
      {essay.excerpt && <p class="dek">{essay.excerpt}</p>}
      <div class="byline">
        <span class="name">{site.name}</span>
        {essay.period && <Fragment><span class="dot">·</span><span>{essay.period}</span></Fragment>}
        {minutes > 0 && <Fragment><span class="dot">·</span><span>{minutes} min read</span></Fragment>}
      </div>
    </header>

    {img && (
      <figure class="essay-hero">
        <img src={img} alt={essay.title} />
      </figure>
    )}

    {bodyHtml ? (
      <div class="essay-body">
        <Fragment set:html={bodyHtml} />
        <div class="essay-end">
          <div class="sig">{firstName}</div>
          {essay.period && <div class="meta">{essay.period}</div>}
        </div>
      </div>
    ) : (
      <div class="essay-body">
        <p><em>The full essay is on its way — check back soon.</em></p>
      </div>
    )}

    <nav class="essay-nav">
      <a class="prev" href="/creative/">
        <span class="lbl">Return</span>
        <span class="ttl">The notebook</span>
      </a>
    </nav>
  </article>
</Base>
